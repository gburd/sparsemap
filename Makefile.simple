# Simple Makefile for sparsemap (no autotools required)
# Usage: make -f Makefile.simple

PREFIX ?= /usr/local
DESTDIR ?=

CC = cc
AR = ar
CFLAGS = -std=gnu11 -Wall -Wextra -Werror -I./include
LDFLAGS =
LIBS = -lpthread

# Debug flags
ifdef DEBUG
    CFLAGS += -g -O0 -DDEBUG
else
    CFLAGS += -O3
endif

# Diagnostic flags
ifdef DIAGNOSTIC
    CFLAGS += -DSPARSEMAP_DIAGNOSTIC
endif

# Testing flags
ifdef TESTING
    CFLAGS += -DSPARSEMAP_TESTING
endif

# Coverage flags
ifdef COVERAGE
    CFLAGS += -fprofile-arcs -ftest-coverage -O0
    LDFLAGS += -fprofile-arcs
    # Note: -lgcov not needed on macOS/clang, coverage is built-in
endif

# Library
LIB_STATIC = libsparsemap.a
LIB_SHARED = libsparsemap.dylib
LIB_SOURCES = src/sparsemap.c
LIB_OBJECTS = src/sparsemap.o
LIB_HEADERS = include/sparsemap.h include/popcount.h

# Tests
TEST_SOURCES = tests/test.c tests/common.c tests/munit.c tests/qc.c \
               tests/roaring.c tests/tdigest.c tests/midl.c
TEST_OBJECTS = $(TEST_SOURCES:.c=.o)
TEST_BINARY = tests/test
TEST_LIB_OBJECT = src/sparsemap_testing.o

RLE_TEST_SOURCES = tests/test_rle_standalone.c
RLE_TEST_OBJECTS = $(RLE_TEST_SOURCES:.c=.o)
RLE_TEST_BINARY = tests/test_rle_standalone

SOAK_SOURCES = tests/soak.c tests/common.c tests/roaring.c tests/tdigest.c
SOAK_OBJECTS = $(SOAK_SOURCES:.c=.o)
SOAK_BINARY = tests/soak

# Examples
EXAMPLE_SOURCES = $(wildcard examples/ex_*.c)
EXAMPLE_OBJECTS = $(EXAMPLE_SOURCES:.c=.o)
EXAMPLE_BINARIES = $(EXAMPLE_SOURCES:.c=)
EXAMPLE_COMMON = tests/common.o tests/munit.o tests/qc.o

.PHONY: all clean install uninstall check examples help coverage coverage-report clean-coverage format format-check tidy shellcheck lint

all: $(LIB_STATIC) $(LIB_SHARED)

help:
	@echo "Sparsemap Simple Makefile"
	@echo ""
	@echo "Targets:"
	@echo "  all              Build static and shared libraries (default)"
	@echo "  tests            Build test suite"
	@echo "  examples         Build example programs"
	@echo "  check            Run tests"
	@echo "  coverage         Build with coverage and generate report"
	@echo "  coverage-report  Open coverage HTML report"
	@echo "  clean-coverage   Remove coverage data"
	@echo "  format           Format code with clang-format"
	@echo "  format-check     Check code formatting"
	@echo "  tidy             Run clang-tidy static analysis"
	@echo "  shellcheck       Lint shell scripts"
	@echo "  lint             Run format-check and shellcheck"
	@echo "  install          Install library and headers"
	@echo "  uninstall        Remove installed files"
	@echo "  clean            Remove built files"
	@echo ""
	@echo "Options:"
	@echo "  PREFIX=/path     Installation prefix (default: /usr/local)"
	@echo "  DEBUG=1          Enable debug build"
	@echo "  DIAGNOSTIC=1     Enable diagnostic output"
	@echo "  TESTING=1        Enable testing support"
	@echo "  COVERAGE=1       Enable coverage instrumentation"
	@echo ""
	@echo "Examples:"
	@echo "  make -f Makefile.simple"
	@echo "  make -f Makefile.simple DEBUG=1"
	@echo "  make -f Makefile.simple tests check"
	@echo "  make -f Makefile.simple coverage"
	@echo "  make -f Makefile.simple PREFIX=/tmp/sparsemap install"

# Library targets
$(LIB_STATIC): $(LIB_OBJECTS)
	$(AR) rcs $@ $^

$(LIB_SHARED): $(LIB_OBJECTS)
	$(CC) -shared -o $@ $^ $(LDFLAGS) $(LIBS)

src/sparsemap.o: src/sparsemap.c $(LIB_HEADERS)
	$(CC) -std=gnu11 -Wall -Wextra $(if $(COVERAGE),,-Werror) -I./include $(if $(DEBUG),-g -O0 -DDEBUG,-O3) $(if $(DIAGNOSTIC),-DSPARSEMAP_DIAGNOSTIC) $(if $(COVERAGE),-fprofile-arcs -ftest-coverage -O0) -c -o $@ $<

# Test targets
tests: CFLAGS += -DSPARSEMAP_TESTING -I./tests
tests: CFLAGS := $(filter-out -Werror,$(CFLAGS))
tests: $(TEST_BINARY) $(RLE_TEST_BINARY) $(SOAK_BINARY)

$(TEST_BINARY): $(TEST_OBJECTS) $(TEST_LIB_OBJECT) $(LIB_STATIC)
	$(CC) $(CFLAGS) -o $@ $(TEST_OBJECTS) $(TEST_LIB_OBJECT) $(LIB_STATIC) $(LDFLAGS) $(LIBS)

# Build testing-enabled version of library for QuickCheck functions
src/sparsemap_testing.o: src/sparsemap.c $(LIB_HEADERS)
	$(CC) -std=gnu11 -Wall -Wextra -I./include -I./tests $(if $(DEBUG),-g -O0 -DDEBUG,-O3) $(if $(DIAGNOSTIC),-DSPARSEMAP_DIAGNOSTIC) $(if $(COVERAGE),-fprofile-arcs -ftest-coverage -O0) -DSPARSEMAP_TESTING -c -o $@ $<

$(RLE_TEST_BINARY): $(RLE_TEST_OBJECTS) $(LIB_STATIC)
	$(CC) -o $@ $(RLE_TEST_OBJECTS) $(LIB_STATIC) $(LDFLAGS) $(LIBS)

$(SOAK_BINARY): $(SOAK_OBJECTS) $(LIB_STATIC)
	$(CC) $(CFLAGS) -o $@ $(SOAK_OBJECTS) $(LIB_STATIC) $(LDFLAGS) $(LIBS)

tests/test_rle_standalone.o: tests/test_rle_standalone.c
	$(CC) -std=gnu11 -Wall -Wextra -I./include -O3 -c -o $@ $<

tests/%.o: tests/%.c
	$(CC) -std=gnu11 -Wall -Wextra -I./include -I./tests $(if $(DEBUG),-g -O0 -DDEBUG,-O3) $(if $(DIAGNOSTIC),-DSPARSEMAP_DIAGNOSTIC) $(if $(COVERAGE),-fprofile-arcs -ftest-coverage -O0) -DSPARSEMAP_TESTING -c -o $@ $<

# Example targets
examples: CFLAGS += -I./tests
examples: $(LIB_STATIC) $(EXAMPLE_COMMON) $(EXAMPLE_BINARIES)

examples/ex_%: examples/ex_%.o $(EXAMPLE_COMMON) $(LIB_STATIC)
	$(CC) $(CFLAGS) -o $@ $< $(EXAMPLE_COMMON) $(LIB_STATIC) $(LDFLAGS) $(LIBS)

examples/%.o: examples/%.c
	$(CC) $(CFLAGS) -I./tests -c -o $@ $<

# Check target
check: tests
	@echo "Running test suite..."
	@./$(TEST_BINARY) || (echo "Test suite failed"; exit 1)
	@echo "Running RLE standalone test..."
	@./$(RLE_TEST_BINARY) || (echo "RLE test failed"; exit 1)
	@echo ""
	@echo "✓ All tests passed!"

# Install target
install: $(LIB_STATIC) $(LIB_SHARED)
	install -d $(DESTDIR)$(PREFIX)/lib
	install -d $(DESTDIR)$(PREFIX)/include
	install -m 644 $(LIB_STATIC) $(DESTDIR)$(PREFIX)/lib/
	install -m 755 $(LIB_SHARED) $(DESTDIR)$(PREFIX)/lib/
	install -m 644 $(LIB_HEADERS) $(DESTDIR)$(PREFIX)/include/
	@echo ""
	@echo "Installed to $(PREFIX)"
	@echo "  Library: $(PREFIX)/lib/$(LIB_STATIC)"
	@echo "  Library: $(PREFIX)/lib/$(LIB_SHARED)"
	@echo "  Headers: $(PREFIX)/include/{sparsemap.h,popcount.h}"

# Uninstall target
uninstall:
	rm -f $(DESTDIR)$(PREFIX)/lib/$(LIB_STATIC)
	rm -f $(DESTDIR)$(PREFIX)/lib/$(LIB_SHARED)
	rm -f $(DESTDIR)$(PREFIX)/include/sparsemap.h
	rm -f $(DESTDIR)$(PREFIX)/include/popcount.h
	@echo "Uninstalled from $(PREFIX)"

# Clean target
clean:
	rm -f $(LIB_STATIC) $(LIB_SHARED)
	rm -f $(LIB_OBJECTS)
	rm -f $(TEST_OBJECTS) $(TEST_BINARY)
	rm -f $(RLE_TEST_OBJECTS) $(RLE_TEST_BINARY)
	rm -f $(SOAK_OBJECTS) $(SOAK_BINARY)
	rm -f $(EXAMPLE_OBJECTS) $(EXAMPLE_BINARIES)
	rm -f tests/*.o examples/*.o src/*.o
	@echo "Cleaned build artifacts"

# Coverage targets
coverage: clean
	@echo "Building with coverage instrumentation..."
	@$(MAKE) -f Makefile.simple COVERAGE=1 DEBUG=1 tests
	@echo "Running tests to generate coverage data..."
	@./$(TEST_BINARY) || true
	@echo ""
	@echo "Generating coverage report..."
	@mkdir -p coverage
	@cd src && gcov -o . sparsemap_testing.gcda > ../coverage/gcov.log 2>&1 || true
	@mv src/*.gcov coverage/ 2>/dev/null || true
	@echo ""
	@echo "Coverage Summary:"
	@grep "Lines executed" coverage/gcov.log
	@grep "Branches taken" coverage/gcov.log || true
	@echo ""
	@echo "Detailed coverage in coverage/sparsemap.c.gcov"
	@echo "Run: less coverage/sparsemap.c.gcov"

coverage-report:
	@if [ -d coverage/html ]; then \
		open coverage/html/index.html || xdg-open coverage/html/index.html || \
		echo "Open coverage/html/index.html in your browser"; \
	else \
		echo "Run 'make -f Makefile.simple coverage' first"; \
	fi

clean-coverage:
	rm -rf coverage *.gcov *.gcda *.gcno
	rm -f src/*.gcda src/*.gcno tests/*.gcda tests/*.gcno
	@echo "Cleaned coverage data"

# Code quality targets
format:
	@echo "Formatting code with clang-format..."
	@command -v clang-format >/dev/null 2>&1 || \
		(echo "clang-format not found. Install with: brew install clang-format" && exit 1)
	@clang-format -i src/*.c include/*.h tests/*.c tests/*.h 2>/dev/null || true
	@echo "Code formatted"

format-check:
	@echo "Checking code formatting..."
	@command -v clang-format >/dev/null 2>&1 || \
		(echo "clang-format not found. Install with: brew install clang-format" && exit 1)
	@clang-format --dry-run --Werror src/*.c include/*.h tests/*.c tests/*.h 2>/dev/null || \
		(echo "Code formatting issues found. Run: make -f Makefile.simple format" && exit 1)
	@echo "Code formatting OK"

tidy:
	@echo "Running clang-tidy on library source..."
	@command -v clang-tidy >/dev/null 2>&1 || \
		(echo "clang-tidy not found. Install with: brew install llvm" && exit 1)
	@clang-tidy src/sparsemap.c -- -I./include -std=gnu11 || true
	@echo "clang-tidy complete"

shellcheck:
	@echo "Linting shell scripts with shellcheck..."
	@command -v shellcheck >/dev/null 2>&1 || \
		(echo "shellcheck not found. Install with: brew install shellcheck" && exit 1)
	@shellcheck autogen.sh || (echo "shellcheck found issues in autogen.sh" && exit 1)
	@echo "Shell scripts OK"

lint: format-check shellcheck
	@echo "All lint checks passed"
