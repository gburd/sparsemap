# Sparsemap .gitignore

# ──────────────────────────────────────────────────────────────────
# Compiled artifacts
# ──────────────────────────────────────────────────────────────────
*.o
*.lo
*.a
*.so
*.so.*
*.dylib
*.dll
*.la
*.gcno
*.gcda
*.gcov

# ──────────────────────────────────────────────────────────────────
# Build directories (meson primary, others legacy)
# ──────────────────────────────────────────────────────────────────
builddir/
builddir-*/
build/
build-*/
cmake-build*/
.cmake_dirty
# Coverage / review build dirs (measure_coverage.sh, ad-hoc reviews).
# The review found cov-review/ was not ignored.
cov*/

# ──────────────────────────────────────────────────────────────────
# Documentation generated output
# ──────────────────────────────────────────────────────────────────
docs/api/
docs/html/
docs/latex/
docs/man/
doxygen-warnings.txt

# ──────────────────────────────────────────────────────────────────
# Coverage outputs (regenerated by scripts/measure_coverage.sh)
# ──────────────────────────────────────────────────────────────────
coverage/

# ──────────────────────────────────────────────────────────────────
# Editor / OS / nix scratch
# ──────────────────────────────────────────────────────────────────
*~
.DS_Store
*.swp
result
result-*

# ──────────────────────────────────────────────────────────────────
# Compile-commands (generated by meson if requested)
# ──────────────────────────────────────────────────────────────────
compile_commands.json

# ──────────────────────────────────────────────────────────────────
# Legacy autotools artifacts (kept for any branch still using
# autotools; the canonical build is meson)
# ──────────────────────────────────────────────────────────────────
.deps/
.libs/
autom4te.cache/
aclocal.m4
compile
config.guess
config.h
config.h.in
config.h.in~
config.log
config.status
config.sub
configure
configure~
depcomp
install-sh
libtool
ltmain.sh
missing
stamp-h1
test-driver
Makefile.in
*.pc
sparsemap.pc

# ──────────────────────────────────────────────────────────────────
# Stale top-level test executables that some legacy harnesses drop
# alongside the source.  Meson builds put these under builddir/.
# ──────────────────────────────────────────────────────────────────
tests/test_rle_standalone
tests/test_heisenbug
tests/test_empty_map
tests/test
tests/soak
bench/sparsemap_bench
examples/ex_[0-9]
vgcore.*

# Core dumps
core
core.*
# Rust build artifacts
/rust/target/
rust/Cargo.lock
# Hegel-c build scratch
.hegel-c/
.hegel/

# python port artifacts
/python/target/
/python/.venv/
__pycache__/
.pytest_cache/
/python/uv.lock
/python/Cargo.lock
/python/tests/fixtures/
# ──────────────────────────────────────────────────────────────────
# Secrets, credentials, profiling and fuzzer output that must never
# be committed (see SECURITY.md / CONTRIBUTING.md).  A crashing binary
# under an unlimited core ulimit can drop the live environment here.
# ──────────────────────────────────────────────────────────────────
# perf(1) profiling data
perf.data
perf.data.*
# dotenv secrets (but NOT the tracked .envrc)
.env
.env.*
.envrc.local
# keys / certificates
*.pem
id_rsa
id_rsa.*
id_ed25519*
# libFuzzer crash / hang artifacts
crash-*
timeout-*
oom-*
leak-*
slow-unit-*
# cargo package archives
*.crate
