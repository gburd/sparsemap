if ! has nix_direnv_version || ! nix_direnv_version 3.0.4; then
    source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.0.4/direnvrc" "sha256-DzlYZ33mWF/Gs8DDeyjr8mnVmQGx7ASYqA5WlxwvBG4="
fi
watch_file shell.nix flake.nix
use flake || use nix

# Maintainer-personal direnv helpers (project_steering / project_mcp)
# live only in ~/.config/direnv/lib and fail for anyone else.  Keep
# them out of the tracked .envrc; put local-only lines in .envrc.local
# (gitignored), which this sources if present.
source_env_if_exists .envrc.local
